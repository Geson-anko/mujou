# Recipes are written for a Unix shell; on Windows run them through Git Bash.
[windows]
set shell := ["C:/Program Files/Git/bin/bash.exe", "-c"]

set dotenv-load := true

# Default recipe (shows help)
default:
    @just --list

# Setup the development environment
setup:
    uv venv --clear
    uv sync
    uv run pre-commit install

# Run pre-commit hooks (ruff fix + format, mdformat, codespell, ...)
format:
    uv run pre-commit run -a

# Run cargo test and pytest (all tests, including slow ones)
test:
    cargo test --workspace
    uv run pytest -v --cov

# Run cargo test and pytest without slow convergence / training checks
test-fast:
    cargo test --workspace
    uv run pytest -v -m "not slow"

# Run pyright strict over src/
type:
    uv run pyright

# Run all checks (format, test, type)
run: format test type

# Clean autogenerated files
clean:
    rm -rf dist build htmlcov .coverage
    find . -type d -name "__pycache__" -prune -exec rm -r {} +
    find . -type d -name ".pytest_cache" -prune -exec rm -r {} +

# Run a command in the dev container, in this checkout (the main one or a worktree)
[positional-arguments]
container *args:
    #!/usr/bin/env bash
    set -euo pipefail
    main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    devcontainer up --workspace-folder "$main" > /dev/null
    devcontainer exec --workspace-folder "$main" bash -lc 'cd "$1" && shift && exec "$@"' _ "{{justfile_directory()}}" "$@"

# Generate the type stub of the native extension (src/mujou/_core.pyi) from its
# signatures and doc comments. Commit the result; pre-commit regenerates it.
stub:
    #!/usr/bin/env bash
    set -euo pipefail
    # `uv run` rebuilds the extension first if the Rust sources changed.
    read -r library module output < <(uv run --quiet python -c '
    import importlib.util, tomllib
    with open("pyproject.toml", "rb") as f:
        module = tomllib.load(f)["tool"]["maturin"]["module-name"]
    print(importlib.util.find_spec(module).origin, module, "src/" + module.replace(".", "/") + ".pyi")
    ')
    cargo run --quiet -p mujou-stubgen -- "$library" "$module" "$output"
    uv run --quiet ruff check --quiet --fix "$output"
    uv run --quiet ruff format --quiet "$output"
