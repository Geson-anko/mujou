# Recipes are written for a Unix shell; on Windows run them through Git Bash.
[windows]
set shell := ["C:/Program Files/Git/bin/bash.exe", "-c"]

set dotenv-load := true

# Default recipe (shows help)
default:
    @just --list

# Setup the development environment
setup:
    uv venv --clear
    uv sync
    uv run pre-commit install

# Run pre-commit hooks (ruff fix + format, mdformat, codespell, ...)
format:
    uv run pre-commit run -a

# Run cargo test and pytest (all tests, including slow ones)
test: test-rs test-py

# Run cargo test over the Rust workspace
test-rs:
    cargo test --workspace

# Run pytest (all tests, including slow ones) with coverage
test-py:
    uv run pytest -v --cov

# Run cargo test and pytest without slow convergence / training checks
test-fast:
    cargo test --workspace
    uv run pytest -v -m "not slow"

# Run pyright strict over src/
type:
    uv run pyright

# Run all checks (format, test, type, strict build of the documentation)
run: format test type docs-build

# Serve the documentation at http://127.0.0.1:8000 with live reload (e.g. `just docs -a 127.0.0.1:8001`)
[positional-arguments]
docs *args:
    uv run mkdocs serve "$@"

# Build the documentation into site/, failing on any warning (broken links, missing API objects)
docs-build:
    uv run mkdocs build --strict

# Clean autogenerated files
clean:
    rm -rf dist build site htmlcov .coverage
    find . -type d -name "__pycache__" -prune -exec rm -r {} +
    find . -type d -name ".pytest_cache" -prune -exec rm -r {} +

# Run a command in the dev container, in this checkout (the main one or a worktree)
[positional-arguments]
container *args:
    #!/usr/bin/env bash
    set -euo pipefail
    main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    devcontainer up --workspace-folder "$main" > /dev/null
    devcontainer exec --workspace-folder "$main" bash -lc 'cd "$1" && shift && exec "$@"' _ "{{justfile_directory()}}" "$@"

# Generate src/mujou/_core/_native.pyi from the Rust signatures and doc comments (commit it)
stub:
    #!/usr/bin/env -S uv run --quiet python
    import importlib.util, re, subprocess, tomllib
    with open("pyproject.toml", "rb") as f:
        module = tomllib.load(f)["tool"]["maturin"]["module-name"]
    # `uv run` rebuilt the extension first if the Rust sources changed.
    library = importlib.util.find_spec(module).origin
    output = "src/" + module.replace(".", "/") + ".pyi"
    subprocess.run(["cargo", "run", "--quiet", "-p", "mujou-stubgen", "--", library, module, output], check=True)
    # Format with the ruff of the pre-commit hook, so that the two agree.
    with open(".pre-commit-config.yaml") as f:
        version = re.search(r"ruff-pre-commit\n\s+rev: v(\S+)", f.read()).group(1)
    ruff = ["uv", "tool", "run", "--quiet", f"ruff@{version}"]
    subprocess.run([*ruff, "check", "--quiet", "--fix", output], check=True)
    subprocess.run([*ruff, "format", "--quiet", output], check=True)
